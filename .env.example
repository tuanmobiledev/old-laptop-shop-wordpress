# OSCAR Shop WordPress — env template
#
# This file is for local dev only (`docker compose -f docker-compose.wp.yml up`).
# For full env var documentation, see `.env.wp-example` next to docker-compose.wp.yml.
# On prod (Coolify), env vars are set in the service UI — this file is ignored.

# Required: WP admin password (set to your prod password for local mirror)
WP_ADMIN_PASSWORD=

# Optional: Nhanh credentials for sync testing
# Leave blank if you don't need Nhanh sync on local dev
NHANH_APP_ID=
NHANH_BUSINESS_ID=
NHANH_DEPOT_ID=
NHANH_API_TOKEN=