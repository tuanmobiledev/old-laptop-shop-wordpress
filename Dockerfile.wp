# OSCAR Shop WordPress image — based on official wordpress:6.9-php8.3-apache
# Built from v14 image Dockerfile (extracted via docker history).
# Replaces the laprevive-web multi-stage Dockerfile that was committed by mistake.

FROM wordpress:6.9-php8.3-apache

# Install wp-cli
RUN curl -fsS -o /usr/local/bin/wp \
    https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
 && chmod +x /usr/local/bin/wp

# Custom OSCAR Shop content (theme + plugins + mu-plugins)
# SPLIT into separate layers (Boss 2026-08-20): single COPY wp-content/
# was 1.47GB in one layer → docker push stalls on that one large layer
# over slow networks. Each COPY below is < 1GB individually so pushes
# succeed and cache hits on future builds (themes/plugins rarely change).
COPY wp-content/themes/ /usr/src/wordpress/wp-content/themes/
COPY wp-content/plugins/ /usr/src/wordpress/wp-content/plugins/
COPY wp-content/mu-plugins/ /usr/src/wordpress/wp-content/mu-plugins/
COPY wp-content/index.php /usr/src/wordpress/wp-content/index.php

# OSCAR auto-fix entrypoint scripts
COPY scripts/wp-init.sh /usr/local/bin/wp-init.sh
COPY scripts/wp-entrypoint-wrapper.sh /usr/local/bin/wp-entrypoint-wrapper.sh
COPY scripts/patch-entrypoint.sh /usr/local/bin/patch-entrypoint.sh
COPY scripts/db_check.php /usr/local/bin/db_check.php

RUN chmod +x /usr/local/bin/wp-init.sh /usr/local/bin/wp-entrypoint-wrapper.sh /usr/local/bin/patch-entrypoint.sh \
 && /usr/local/bin/patch-entrypoint.sh \
 && chown -R www-data:www-data /usr/src/wordpress/wp-content

# Image metadata — bump version per deploy
ARG IMAGE_VERSION=v47.7-policy-hero-mobile-radius-2026-08-31
LABEL org.opencontainers.image.title="wordpress-oscar" \
      org.opencontainers.image.description="WordPress 6.9 with Oscar Shop theme + WooCommerce + Nhanh sync + auto-fix (v47.5-banner-cta-2026-08-31 wire CTA destination cho 3 hero banners trên home, click trước đây là <strong> thuần text 0 action)" \
      org.opencontainers.image.licenses="Proprietary" \
      org.opencontainers.image.source="https://github.com/tuanmobiledev/old-laptop-shop" \
      org.opencontainers.image.version=${IMAGE_VERSION}

# Health check (prod LB uses this)
HEALTHCHECK --interval=30s --timeout=10s --start-period=2m --retries=3 \
  CMD curl -fsS http://localhost/ >/dev/null 2>&1 || exit 1

# Override official entrypoint to run wp-init.sh before apache
ENTRYPOINT ["/usr/local/bin/wp-entrypoint-wrapper.sh"]
CMD ["apache2-foreground"]
